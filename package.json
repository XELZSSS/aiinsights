{
  "name": "aiinsights",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "preview": "vite build && vite preview",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.0",
    "hono": "^4.12.21",
    "lucide-react": "^1.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "^5.20260817.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.74.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.13",
    "wrangler": "^4.20.0"
  },
  "allowScripts": {
    "workerd@1.20260811.1": true,
    "esbuild@0.28.1": true
  }
}
