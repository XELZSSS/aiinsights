{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aiinsights",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-07-14",
  "keep_vars": true,
  "workers_dev": false,

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "cache": {
    "enabled": true
  },

  "placement": {
    "mode": "smart"
  },

  "triggers": {
    "crons": ["*/4 * * * *"]
  },

  "observability": {
    "enabled": true
  },

  "kv_namespaces": [
    {
      "binding": "METRICS",
      "id": "2da8406333284ec79307b7b75034fec7"
    }
  ],

  "dev": {
    "port": 3000
  }
}