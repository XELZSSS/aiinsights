{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aiinsights",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-07-14",
  "keep_vars": true,
  "workers_dev": false,

  // Serve the built Vite client from the ASSETS binding; unknown routes fall back to index.html for the SPA.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "cache": {
    "enabled": true
  },

  // Smart placement co-locates the Worker with the KV store for lower latency.
  "placement": {
    "mode": "smart"
  },

  // Cron job refreshes the upstream data cache every 4 minutes.
  "triggers": {
    "crons": ["*/4 * * * *"]
  },

  "observability": {
    "enabled": true
  },

  // KV namespace that backs the upstream-data cache (raw sources + parsed payloads).
  "kv_namespaces": [
    {
      "binding": "METRICS",
      "id": "2da8406333284ec79307b7b75034fec7"
    }
  ],

  "dev": {
    "port": 3000
  }
}